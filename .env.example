PORT=3000

# Firebase Web Config (optional overrides; defaults load from firebase-web-config.json)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# WebRTC TURN Relay (recommended for slow mobile data / CGNAT)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Android APK & Closed-Browser Push Notifications
FCM_SERVICE_ACCOUNT_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_WORKER_URL=
